# ==========================================
# Econnex Voice Recovery Agent - Environment Configuration Example
# Copy this file to .env and fill in your values
# ==========================================

# Vapi WebRTC & API Credentials
VAPI_PUBLIC_KEY=your_vapi_public_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# Google Apps Script Webhook Endpoint
APPS_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec

# Optional: CIMET Official Sandbox URL (When provided on-site)
JOURNEY_SANDBOX_URL=
